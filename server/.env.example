# Local database
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=poscon
PG_PASSWORD=postgres
PG_PORT=5432

# Hosted database (e.g. Neon). When set, it is used instead of the PG_* values above
# DATABASE_URL=postgresql://user:password@host/poscon?sslmode=require
# Set to false only for a hosted database without SSL
# DATABASE_SSL=true

# Port the API listens on
PORT=9000

# Frontend URL(s) allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:3000

# Used to sign login tokens, use a long random string
SESSION_SECRET=change-me

# Number of proxies in front of the API (set to 1 on Render)
# TRUST_PROXY=0

# Admin account created by the seed script; set a private password when deploying
# ADMIN_EMAIL=admin@poscon.dev
# ADMIN_PASSWORD=admin1234
